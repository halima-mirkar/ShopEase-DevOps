<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="ShopEaseNew.SiteMaster" %>

<!DOCTYPE html>

<html>

<head runat="server">

    <title>ShopEase</title>

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1" />

    <!-- BOOTSTRAP CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <!-- BOOTSTRAP ICONS -->

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <!-- GOOGLE FONT -->

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:'Poppins',sans-serif;
            background:#f5f7fb;
        }

        /* NAVBAR */

        .navbar{
            background:
            linear-gradient(135deg,#0d6efd,#6610f2);

            padding:15px 0;
        }

        .navbar-brand{
            font-size:28px;
            font-weight:700;
            color:white !important;
        }

        .nav-link{
            color:white !important;
            margin-left:12px;
            transition:0.3s;
        }

        .nav-link:hover{
            color:#ffd43b !important;
        }

        /* SEARCH SECTION */

        .search-box{
            display:flex;
            gap:10px;
        }

        .search-input{
            border-radius:30px;
            padding:8px 15px;
        }

        /* MAIN CONTENT */

        .main-content{
            min-height:80vh;
        }

        /* FOOTER */

        footer{
            background:#111827;
            color:white;
            padding:40px 20px;
            margin-top:50px;
        }

        .footer-link{
            color:#ccc;
            text-decoration:none;
            display:block;
            margin-bottom:10px;
        }

        .footer-link:hover{
            color:#ffd43b;
        }

        .footer-bottom{
            border-top:
            1px solid rgba(255,255,255,0.2);

            margin-top:20px;
            padding-top:15px;
            text-align:center;
        }

        /* RESPONSIVE DESIGN */

        @media(max-width:768px){

            .search-box{
                flex-direction:column;
                margin-top:10px;
            }

            .search-input{
                width:100%;
            }
        }

    </style>

    <!-- CONTENT PLACE HOLDER -->

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

    <form id="form1"
        runat="server">

        <!-- AJAX SCRIPT MANAGER -->

        <asp:ScriptManager
            ID="ScriptManager1"
            runat="server">
        </asp:ScriptManager>

        <!-- NAVBAR -->

        <nav class="navbar navbar-expand-lg navbar-dark">

            <div class="container">

                <!-- WEBSITE LOGO -->

                <a class="navbar-brand"
                    href="Home.aspx">

                    <i class="bi bi-bag-heart-fill"></i>

                    ShopEase

                </a>

                <!-- MOBILE MENU BUTTON -->

                <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>

                <!-- NAVIGATION MENU -->

                <div class="collapse navbar-collapse"
                    id="navbarNav">

                    <ul class="navbar-nav ms-auto align-items-center">

                        <li class="nav-item">

                            <a class="nav-link"
                                href="Home.aspx">

                                <i class="bi bi-house-fill"></i>
                                Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                href="Products.aspx">

                                <i class="bi bi-grid-fill"></i>
                                Products

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                href="Electronics.aspx">

                                <i class="bi bi-phone-fill"></i>
                                Electronics

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                href="Fashion.aspx">

                                <i class="bi bi-bag-fill"></i>
                                Fashion

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                href="Cart.aspx">

                                <i class="bi bi-cart-fill"></i>
                                Cart

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                href="Orders.aspx">

                                <i class="bi bi-box-seam"></i>
                                Orders

                            </a>

                        </li>

                        <!-- SEARCH FEATURE -->

                        <li class="nav-item ms-3">

                            <div class="search-box">

                                <asp:TextBox
                                    ID="txtSearch"
                                    runat="server"
                                    CssClass="form-control search-input"
                                    placeholder="Search products">
                                </asp:TextBox>

                                <asp:Button
                                    ID="btnSearch"
                                    runat="server"
                                    Text="Search"
                                    CssClass="btn btn-warning"
                                    OnClick="btnSearch_Click" />

                            </div>

                        </li>

                        <!-- USER SESSION -->

                        <li class="nav-item ms-3">

                            <asp:Label
                                ID="lblUser"
                                runat="server"
                                CssClass="text-warning fw-bold">
                            </asp:Label>

                        </li>

                        <!-- LOGOUT -->

                        <li class="nav-item ms-2">

                            <asp:Button
                                ID="btnLogout"
                                runat="server"
                                Text="Logout"
                                CssClass="btn btn-danger btn-sm"
                                OnClick="btnLogout_Click" />

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

        <!-- MAIN CONTENT AREA -->

        <div class="container mt-4 main-content">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

        <!-- FOOTER -->

        <footer>

            <div class="container">

                <div class="row">

                    <div class="col-md-6">

                        <h4>
                            ShopEase
                        </h4>

                        <p>
                            ASP.NET Web Forms E-Commerce
                            Website using Master Pages,
                            AJAX, Validation Controls,
                            Session State and
                            Connected/Disconnected ADO.NET.
                        </p>

                    </div>

                    <div class="col-md-6">

                        <h4>
                            Quick Links
                        </h4>

                        <a href="Home.aspx"
                            class="footer-link">
                            Home
                        </a>

                        <a href="Products.aspx"
                            class="footer-link">
                            Products
                        </a>

                        <a href="Cart.aspx"
                            class="footer-link">
                            Cart
                        </a>

                        <a href="Orders.aspx"
                            class="footer-link">
                            Orders
                        </a>

                    </div>

                </div>

                <div class="footer-bottom">

                    © 2026 ShopEase |
                    Advanced Web Technology Project

                </div>

            </div>

        </footer>

    </form>

    <!-- BOOTSTRAP JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>